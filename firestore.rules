rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== PRIMITIVES ====================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function affectedOnly(fields) {
      return incoming().diff(existing()).affectedKeys().hasOnly(fields);
    }

    function isDmMember(pairId) {
      return isSignedIn()
        && pairId is string
        && pairId.size() >= 3
        && pairId.size() <= 260
        && pairId != request.auth.uid + '_' + request.auth.uid
        && (
          pairId.matches('^' + request.auth.uid + '_[A-Za-z0-9\\-]+$')
          || pairId.matches('^[A-Za-z0-9\\-]+_' + request.auth.uid + '$')
        );
    }

    // ==================== VALIDATION BLUEPRINTS ====================
    function isValidUsernameDoc(data) {
      return data.keys().hasAll(['uid'])
        && data.keys().hasOnly(['uid'])
        && isValidId(data.uid);
    }

    function isValidPlayerStats(stats) {
      return stats is map
        && stats.keys().hasAll(['buildings', 'completedTrades', 'tradesSent', 'tradesReceived', 'cashTraded', 'gemsTraded'])
        && stats.keys().hasOnly(['buildings', 'completedTrades', 'tradesSent', 'tradesReceived', 'cashTraded', 'gemsTraded'])
        && stats.buildings is number && stats.buildings >= 0 && stats.buildings <= 1000000
        && stats.completedTrades is number && stats.completedTrades >= 0 && stats.completedTrades <= 1000000
        && stats.tradesSent is number && stats.tradesSent >= 0 && stats.tradesSent <= 1000000
        && stats.tradesReceived is number && stats.tradesReceived >= 0 && stats.tradesReceived <= 1000000
        && stats.cashTraded is number && stats.cashTraded >= 0 && stats.cashTraded <= 100000000000000
        && stats.gemsTraded is number && stats.gemsTraded >= 0 && stats.gemsTraded <= 1000000000000;
    }

    function isValidPlayerProfile(data) {
      return data.keys().hasAll([
          'username', 'usernameLower', 'countryCode', 'countryName',
          'gdp', 'cash', 'gems', 'level', 'rank', 'lastSeen', 'stats'
        ])
        && data.keys().hasOnly([
          'username', 'usernameLower', 'countryCode', 'countryName',
          'gdp', 'cash', 'gems', 'level', 'rank', 'lastSeen', 'stats', 'createdAt',
          'subTier', 'subExp'
        ])
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 16
        && data.username.matches('^[A-Za-z0-9_]{3,16}$')
        && data.usernameLower is string && data.usernameLower.size() >= 3 && data.usernameLower.size() <= 16
        && data.usernameLower.matches('^[a-z0-9_]{3,16}$')
        && data.username.lower() == data.usernameLower
        && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 3
        && data.countryCode.matches('^[A-Za-z]{2,3}$')
        && data.countryName is string && data.countryName.size() >= 1 && data.countryName.size() <= 64
        && data.gdp is number && data.gdp >= 0 && data.gdp <= 10000000000000
        && data.cash is number && data.cash >= 0 && data.cash <= 10000000000000
        && data.gems is number && data.gems >= 0 && data.gems <= 1000000000
        && data.level is int && data.level >= 1 && data.level <= 10000000
        && data.rank is int && data.rank >= 0 && data.rank <= 10
        && data.lastSeen is timestamp
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('subTier' in data) || data.subTier in ['', 'daily', 'weekly', 'monthly'])
        && (!('subExp' in data) || (data.subExp is number && data.subExp >= 0 && data.subExp <= 10000000000000))
        && isValidPlayerStats(data.stats);
    }

    function isValidWallet(data) {
      return data.keys().hasAll(['cash', 'gems', 'stk', 'rev', 'sid', 't'])
        && data.keys().hasOnly(['cash', 'gems', 'stk', 'rev', 'sid', 't', 'tradeId'])
        && data.cash is number && data.cash >= 0 && data.cash <= 10000000000000
        && data.gems is int && data.gems >= 0 && data.gems <= 1000000000
        && data.stk is map && data.stk.size() <= 48
        && data.rev is int && data.rev >= 1 && data.rev <= 1000000000
        && data.sid is string && data.sid.size() >= 1 && data.sid.size() <= 128
        && data.t is timestamp
        && (!('tradeId' in data) || isValidId(data.tradeId));
    }

    function isValidSession(data) {
      return data.keys().hasAll(['sid', 't'])
        && data.keys().hasOnly(['sid', 't'])
        && data.sid is string && data.sid.size() >= 1 && data.sid.size() <= 128
        && data.t is timestamp;
    }

    function isValidSave(data) {
      return data.keys().hasAll(['save'])
        && data.keys().hasOnly(['save'])
        && data.save is map
        && data.save.size() <= 72
        && (!('cash' in data.save) || (data.save.cash is number && data.save.cash >= 0 && data.save.cash <= 10000000000000))
        && (!('gems' in data.save) || (data.save.gems is number && data.save.gems >= 0 && data.save.gems <= 1000000000))
        && (!('taxPool' in data.save) || (data.save.taxPool is number && data.save.taxPool >= 0 && data.save.taxPool <= 10000000000000))
        && (!('rank' in data.save) || (data.save.rank is int && data.save.rank >= 0 && data.save.rank <= 10))
        && (!('boost' in data.save) || (data.save.boost is number && data.save.boost >= 0 && data.save.boost <= 30))
        && (!('crateCd' in data.save) || (data.save.crateCd is number && data.save.crateCd >= 0 && data.save.crateCd <= 10000000000000))
        && (!('day' in data.save) || (data.save.day is number && data.save.day >= 0 && data.save.day <= 100000000))
        && (!('ev' in data.save) || (data.save.ev is number && data.save.ev >= 0 && data.save.ev <= 1000))
        && (!('t' in data.save) || (data.save.t is number && data.save.t >= 0 && data.save.t <= 10000000000000))
        && (!('lastDaily' in data.save) || (data.save.lastDaily is number && data.save.lastDaily >= 0 && data.save.lastDaily <= 10000000000000))
        && (!('govT' in data.save) || (data.save.govT is number && data.save.govT >= 0 && data.save.govT <= 10000000000000))
        && (!('hap' in data.save) || (data.save.hap is number && data.save.hap >= 0 && data.save.hap <= 100))
        && (!('appr' in data.save) || (data.save.appr is number && data.save.appr >= 0 && data.save.appr <= 100))
        && (!('pop' in data.save) || (data.save.pop is number && data.save.pop >= 1 && data.save.pop <= 100000))
        && (!('fused' in data.save) || (data.save.fused is int && data.save.fused >= 0 && data.save.fused <= 1000000))
        && (!('streak' in data.save) || (data.save.streak is int && data.save.streak >= 0 && data.save.streak <= 10000))
        && (!('gov' in data.save) || data.save.gov in ['rep', 'tech', 'wlf', 'ind'])
        && (!('tax' in data.save) || (data.save.tax is number && data.save.tax >= 5 && data.save.tax <= 45))
        && (!('wel' in data.save) || (data.save.wel is number && data.save.wel >= 0 && data.save.wel <= 50))
        && (!('edu' in data.save) || (data.save.edu is number && data.save.edu >= 0 && data.save.edu <= 30))
        && (!('fuel' in data.save) || (data.save.fuel is number && data.save.fuel >= 0 && data.save.fuel <= 50))
        && (!('carbon' in data.save) || (data.save.carbon is number && data.save.carbon >= 0 && data.save.carbon <= 30))
        && (!('luxury' in data.save) || (data.save.luxury is number && data.save.luxury >= 0 && data.save.luxury <= 25))
        && (!('corp' in data.save) || (data.save.corp is number && data.save.corp >= 0 && data.save.corp <= 30))
        && (!('gst' in data.save) || (data.save.gst is number && data.save.gst >= 0 && data.save.gst <= 25))
        && (!('prop' in data.save) || (data.save.prop is number && data.save.prop >= 0 && data.save.prop <= 15))
        && (!('duty' in data.save) || (data.save.duty is number && data.save.duty >= 0 && data.save.duty <= 30))
        && (!('tourism' in data.save) || (data.save.tourism is number && data.save.tourism >= 0 && data.save.tourism <= 20))
        && (!('digital' in data.save) || (data.save.digital is number && data.save.digital >= 0 && data.save.digital <= 20))
        && (!('rd' in data.save) || (data.save.rd is number && data.save.rd >= 0 && data.save.rd <= 25))
        && (!('green' in data.save) || (data.save.green is number && data.save.green >= 0 && data.save.green <= 25))
        && (!('wealth' in data.save) || (data.save.wealth is number && data.save.wealth >= 0 && data.save.wealth <= 20))
        && (!('transitSub' in data.save) || (data.save.transitSub is number && data.save.transitSub >= 0 && data.save.transitSub <= 25))
        && (!('b' in data.save) || (data.save.b is map && data.save.b.size() <= 35))
        && (!('stk' in data.save) || (data.save.stk is map && data.save.stk.size() <= 48))
        && (!('milestones' in data.save) || (data.save.milestones is map && data.save.milestones.size() <= 40))
        && (!('claimed' in data.save) || (data.save.claimed is map && data.save.claimed.size() <= 20))
        && (!('boosterCd' in data.save) || (data.save.boosterCd is map && data.save.boosterCd.size() <= 20))
        && (!('tech' in data.save) || (data.save.tech is map && data.save.tech.size() <= 16))
        && (!('gx' in data.save) || (data.save.gx is map && data.save.gx.size() <= 12))
        && (!('hist' in data.save) || (data.save.hist is list && data.save.hist.size() <= 60))
        && (!('questIds' in data.save) || (data.save.questIds is list && data.save.questIds.size() <= 10))
        && (!('questDay' in data.save) || (data.save.questDay is string && data.save.questDay.size() <= 32))
        && (!('set' in data.save) || (data.save.set is map && data.save.set.size() <= 10))
        && (!('activeFx' in data.save) || (
          data.save.activeFx is map
          && data.save.activeFx.size() <= 10
          && (!('incomeBoostMult' in data.save.activeFx) || (data.save.activeFx.incomeBoostMult is number && data.save.activeFx.incomeBoostMult >= 1 && data.save.activeFx.incomeBoostMult <= 1.75))
        ))
        && (!('sub' in data.save) || (
          data.save.sub is map
          && data.save.sub.size() <= 5
          && (!('tier' in data.save.sub) || data.save.sub.tier in ['daily', 'weekly', 'monthly'])
          && (!('exp' in data.save.sub) || (data.save.sub.exp is number && data.save.sub.exp >= 0 && data.save.sub.exp <= 10000000000000))
          && (!('lastClaimDay' in data.save.sub) || (data.save.sub.lastClaimDay is string && data.save.sub.lastClaimDay.size() <= 16))
        ))
        && (!('subPromo' in data.save) || (
          data.save.subPromo is map
          && data.save.subPromo.size() <= 5
          && (!('weekKey' in data.save.subPromo) || (data.save.subPromo.weekKey is string && data.save.subPromo.weekKey.size() <= 16))
          && (!('tier' in data.save.subPromo) || data.save.subPromo.tier in ['daily', 'weekly', 'monthly'])
          && (!('pct' in data.save.subPromo) || (data.save.subPromo.pct is number && data.save.subPromo.pct >= 5 && data.save.subPromo.pct <= 40))
          && (!('exp' in data.save.subPromo) || (data.save.subPromo.exp is number && data.save.subPromo.exp >= 0 && data.save.subPromo.exp <= 10000000000000))
        ));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['type', 'text', 'read', 'from', 'createdAt'])
        && data.keys().hasOnly(['type', 'text', 'tradeId', 'read', 'from', 'fromName', 'fromCc', 'createdAt'])
        && data.type in ['dm', 'new_offer', 'accepted', 'rejected', 'cancelled', 'expired']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 200
        && data.text.matches('(?s).*\\S.*')
        && data.read is bool
        && isValidId(data.from)
        && data.createdAt is timestamp
        && (!('tradeId' in data) || data.tradeId == null || isValidId(data.tradeId))
        && (!('fromName' in data) || (data.fromName is string && data.fromName.size() <= 16))
        && (!('fromCc' in data) || (data.fromCc is string && data.fromCc.size() <= 3));
    }

    function isValidProject(data) {
      return data.keys().hasAll(['uid', 'type', 'paid', 'progressMs', 'status', 'claimed', 'startedAt', 'lastTickAt'])
        && data.keys().hasOnly(['uid', 'type', 'paid', 'progressMs', 'status', 'claimed', 'startedAt', 'lastTickAt', 'resolvedAt'])
        && isValidId(data.uid)
        && data.type in ['school', 'hospital', 'bridge', 'highway']
        && data.paid is int && data.paid >= 1 && data.paid <= 3
        && data.progressMs is number && data.progressMs >= 0 && data.progressMs <= 2400000
        && data.status in ['active', 'done', 'failed']
        && data.claimed is bool
        && data.startedAt is timestamp
        && data.lastTickAt is timestamp
        && (!('resolvedAt' in data) || data.resolvedAt == null || data.resolvedAt is timestamp);
    }

    function isValidTrade(data) {
      return data.keys().hasAll([
          'from', 'to', 'fromName', 'toName', 'fromCountry', 'toCountry',
          'participants', 'offerCash', 'offerGems', 'offerStk',
          'reqCash', 'reqGems', 'reqStk', 'message', 'status', 'refunded', 'createdAt', 'expiresAt'
        ])
        && data.keys().hasOnly([
          'from', 'to', 'fromName', 'toName', 'fromCountry', 'toCountry',
          'participants', 'offerCash', 'offerGems', 'offerStk',
          'reqCash', 'reqGems', 'reqStk', 'message', 'status', 'refunded', 'createdAt', 'expiresAt', 'resolvedAt'
        ])
        && isValidId(data.from)
        && isValidId(data.to)
        && data.from != data.to
        && data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 16
        && data.toName is string && data.toName.size() >= 1 && data.toName.size() <= 16
        && data.fromCountry is string && data.fromCountry.size() <= 3
        && data.toCountry is string && data.toCountry.size() <= 3
        && data.participants is list && data.participants.size() == 2
        && data.participants[0] == data.from && data.participants[1] == data.to
        && data.offerCash is number && data.offerCash >= 0 && data.offerCash <= 1000000000000
        && data.offerGems is int && data.offerGems >= 0 && data.offerGems <= 1000000000
        && data.offerStk is map && data.offerStk.size() <= 48
        && data.reqCash is number && data.reqCash == 0
        && data.reqGems is int && data.reqGems == 0
        && data.reqStk is map && data.reqStk.size() == 0
        && data.message is string && data.message.size() <= 140
        && data.status in ['pending', 'accepted', 'rejected', 'cancelled', 'expired']
        && data.refunded is bool
        && data.createdAt is timestamp
        && data.expiresAt is timestamp
        && (!('resolvedAt' in data) || data.resolvedAt == null || data.resolvedAt is timestamp);
    }

    function isValidDailyLimit(data) {
      return data.keys().hasAll(['uid', 'count'])
        && data.keys().hasOnly(['uid', 'count'])
        && isValidId(data.uid)
        && data.count is int && data.count >= 1 && data.count <= 15;
    }

    function isValidGlobalChat(data) {
      return data.keys().hasAll(['uid', 'name', 'cc', 'rank', 'text', 'createdAt'])
        && data.keys().hasOnly(['uid', 'name', 'cc', 'rank', 'text', 'createdAt'])
        && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 16
        && data.cc is string && data.cc.size() <= 3
        && data.rank is int && data.rank >= 0 && data.rank <= 10
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 200
        && data.text.matches('(?s).*\\S.*')
        && data.createdAt is timestamp;
    }

    function isValidDmMessage(data) {
      return data.keys().hasAll(['from', 'text', 'createdAt'])
        && data.keys().hasOnly(['from', 'text', 'createdAt'])
        && isValidId(data.from)
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 300
        && data.text.matches('(?s).*\\S.*')
        && data.createdAt is timestamp;
    }

    // ==================== COLLECTION RULES ====================
    match /usernames/{usernameLower} {
      allow get: if isSignedIn() && isValidId(usernameLower);
      allow list: if false;
      allow create: if isSignedIn()
        && usernameLower is string
        && usernameLower.matches('^[a-z0-9_]{3,16}$')
        && isValidUsernameDoc(incoming())
        && incoming().uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/players/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /players/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && request.query.limit <= 100;
      allow create: if isOwner(uid)
        && isValidId(uid)
        && isValidPlayerProfile(incoming())
        && 'createdAt' in incoming()
        && incoming().createdAt == request.time
        && incoming().lastSeen == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(incoming().usernameLower))
        && existsAfter(/databases/$(database)/documents/players/$(uid)/private/wallet);
      allow update: if isOwner(uid)
        && isValidId(uid)
        && (!('username' in existing()) || incoming().username == existing().username)
        && (!('usernameLower' in existing()) || incoming().usernameLower == existing().usernameLower)
        && (!('createdAt' in existing()) || ('createdAt' in incoming() && incoming().createdAt == existing().createdAt))
        && incoming().lastSeen == request.time
        && (
          affectedOnly(['lastSeen']) ||
          (
            affectedOnly(['gdp', 'cash', 'gems', 'level', 'rank', 'lastSeen', 'stats', 'subTier', 'subExp'])
            && incoming().gdp is number && incoming().gdp >= 0 && incoming().gdp <= 10000000000000
            && incoming().cash is number && incoming().cash >= 0 && incoming().cash <= 10000000000000
            && incoming().gems is number && incoming().gems >= 0 && incoming().gems <= 1000000000
            && incoming().level is int && incoming().level >= 1 && incoming().level <= 10000000
            && incoming().rank is int && incoming().rank >= 0 && incoming().rank <= 10
            && (!('subTier' in incoming()) || incoming().subTier in ['', 'daily', 'weekly', 'monthly'])
            && (!('subExp' in incoming()) || (incoming().subExp is number && incoming().subExp >= 0 && incoming().subExp <= 10000000000000))
            && isValidPlayerStats(incoming().stats)
          )
        );
      allow delete: if false;

      match /private/wallet {
        allow get: if isOwner(uid) && isValidId(uid);
        allow list: if false;
        allow create: if isOwner(uid)
          && isValidId(uid)
          && isValidWallet(incoming())
          && incoming().t == request.time
          && incoming().rev == 1;
        allow update: if isOwner(uid)
          && isValidId(uid)
          && isValidWallet(incoming())
          && incoming().t == request.time
          && (!('rev' in existing()) || incoming().rev >= existing().rev);
        allow delete: if false;
      }

      match /private/session {
        allow get: if isOwner(uid) && isValidId(uid);
        allow list: if false;
        allow create: if isOwner(uid)
          && isValidId(uid)
          && isValidSession(incoming())
          && incoming().t == request.time;
        allow update: if isOwner(uid)
          && isValidId(uid)
          && isValidSession(incoming())
          && incoming().t == request.time
          && affectedOnly(['sid', 't']);
        allow delete: if false;
      }

      match /notifications/{notificationId} {
        allow get: if isOwner(uid) && isValidId(uid) && isValidId(notificationId);
        allow list: if isOwner(uid);
        allow create: if isSignedIn()
          && isValidId(uid)
          && isValidId(notificationId)
          && uid != request.auth.uid
          && isValidNotification(incoming())
          && incoming().from == request.auth.uid
          && incoming().read == false
          && incoming().createdAt == request.time
          && (
            incoming().type == 'dm' ||
            (
              'tradeId' in incoming() &&
              incoming().tradeId is string &&
              isValidId(incoming().tradeId) &&
              existsAfter(/databases/$(database)/documents/trades/$(incoming().tradeId))
            )
          )
          && exists(/databases/$(database)/documents/players/$(uid));
        allow update: if isOwner(uid)
          && isValidId(uid)
          && isValidId(notificationId)
          && isValidNotification(incoming())
          && affectedOnly(['read'])
          && existing().read == false
          && incoming().read == true;
        allow delete: if isOwner(uid) && isValidId(uid) && isValidId(notificationId);
      }

      match /projects/{projectId} {
        allow get: if isOwner(uid) && isValidId(uid) && isValidId(projectId);
        allow list: if isOwner(uid);
        allow create: if isOwner(uid)
          && isValidId(uid)
          && isValidId(projectId)
          && isValidProject(incoming())
          && incoming().uid == uid
          && incoming().paid == 1
          && incoming().progressMs == 0
          && incoming().status == 'active'
          && incoming().claimed == false
          && incoming().startedAt == request.time
          && incoming().lastTickAt == request.time;
        allow update: if isOwner(uid)
          && isValidId(uid)
          && isValidId(projectId)
          && isValidProject(incoming())
          && incoming().uid == existing().uid
          && incoming().type == existing().type
          && incoming().startedAt == existing().startedAt
          && (
            (existing().status == 'active' && affectedOnly(['progressMs', 'lastTickAt']) && incoming().progressMs >= existing().progressMs && incoming().lastTickAt == request.time) ||
            (existing().status == 'active' && affectedOnly(['paid']) && incoming().paid == existing().paid + 1 && incoming().paid <= 3) ||
            (existing().status == 'active' && affectedOnly(['status', 'resolvedAt']) && incoming().status in ['done', 'failed'] && (incoming().status == 'failed' || existing().paid == 3) && incoming().resolvedAt == request.time) ||
            (existing().status == 'active' && affectedOnly(['progressMs', 'lastTickAt', 'status', 'resolvedAt']) && incoming().progressMs >= existing().progressMs && incoming().status in ['done', 'failed'] && (incoming().status == 'failed' || existing().paid == 3) && incoming().lastTickAt == request.time && incoming().resolvedAt == request.time) ||
            (existing().status in ['done', 'failed'] && existing().claimed == false && affectedOnly(['claimed']) && incoming().claimed == true)
          );
        allow delete: if false;
      }
    }

    match /saves/{uid} {
      allow get: if isOwner(uid) && isValidId(uid);
      allow list: if false;
      allow create: if isOwner(uid) && isValidId(uid) && isValidSave(incoming());
      allow update: if isOwner(uid) && isValidId(uid) && isValidSave(incoming());
      allow delete: if false;
    }

    match /trades/{tradeId} {
      allow get: if isSignedIn() && isValidId(tradeId) && request.auth.uid in existing().participants;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && isValidId(tradeId)
        && isValidTrade(incoming())
        && incoming().from == request.auth.uid
        && incoming().to != request.auth.uid
        && incoming().participants == [incoming().from, incoming().to]
        && (incoming().offerCash > 0 || incoming().offerGems > 0 || incoming().offerStk.size() > 0)
        && incoming().status == 'pending'
        && incoming().refunded == false
        && incoming().createdAt == request.time
        && incoming().expiresAt > request.time
        && incoming().expiresAt <= request.time + duration.value(10, 'm')
        && exists(/databases/$(database)/documents/players/$(incoming().to));
      allow update: if isSignedIn()
        && isValidId(tradeId)
        && isValidTrade(incoming())
        && incoming().from == existing().from
        && incoming().to == existing().to
        && incoming().participants == existing().participants
        && incoming().offerCash == existing().offerCash
        && incoming().offerGems == existing().offerGems
        && incoming().offerStk == existing().offerStk
        && incoming().reqCash == existing().reqCash
        && incoming().reqGems == existing().reqGems
        && incoming().reqStk == existing().reqStk
        && incoming().createdAt == existing().createdAt
        && incoming().expiresAt == existing().expiresAt
        && (
          (existing().status == 'pending' && request.auth.uid == existing().to && affectedOnly(['status', 'resolvedAt']) && incoming().status in ['accepted', 'rejected'] && (incoming().status == 'rejected' || request.time < existing().expiresAt) && incoming().resolvedAt == request.time) ||
          (existing().status == 'pending' && request.auth.uid == existing().from && affectedOnly(['status', 'resolvedAt', 'refunded']) && (incoming().status == 'cancelled' || (incoming().status == 'expired' && request.time >= existing().expiresAt)) && incoming().refunded == true && incoming().resolvedAt == request.time) ||
          (existing().status in ['rejected', 'expired'] && existing().refunded == false && request.auth.uid == existing().from && affectedOnly(['refunded']) && incoming().refunded == true)
        );
      allow delete: if false;
    }

    match /dailyLimits/{limitId} {
      allow get: if isSignedIn()
        && isValidId(limitId)
        && limitId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(limitId)
        && limitId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isValidDailyLimit(incoming())
        && incoming().uid == request.auth.uid
        && incoming().count == 1;
      allow update: if isSignedIn()
        && isValidId(limitId)
        && limitId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isValidDailyLimit(incoming())
        && incoming().uid == existing().uid
        && affectedOnly(['count', 'uid'])
        && incoming().count == existing().count + 1
        && incoming().count <= 15;
      allow delete: if false;
    }

    match /globalChat/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId);
      allow list: if isSignedIn() && request.query.limit <= 60;
      allow create: if isSignedIn()
        && isValidId(messageId)
        && isValidGlobalChat(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /dms/{pairId}/messages/{messageId} {
      allow get: if isDmMember(pairId) && isValidId(messageId);
      allow list: if isDmMember(pairId) && request.query.limit <= 60;
      allow create: if isDmMember(pairId)
        && isValidId(messageId)
        && isValidDmMessage(incoming())
        && incoming().from == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
